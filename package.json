  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=0.1.0"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "latest",
    "@types/node": "^25.6.0",
    "typescript": "^5.8.0"
  },
  "license": "MIT",
  "author": "Shiny Hou <opshsy@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sososdk/opencode-tencent-auth.git"
  },
  "homepage": "https://github.com/sososdk/opencode-tencent-auth#readme",
  "bugs": {
    "url": "https://github.com/sososdk/opencode-tencent-auth/issues"
  },
  "keywords": [
    "opencode",
    "plugin",
    "codebuddy",
    "workbuddy",
    "tencent",
    "ioa",
    "authentication"
