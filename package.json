{
  "name": "opencode-tencent-auth",
  "version": "0.3.1",
  "description": "OpenCode plugin for CodeBuddy & WorkBuddy (CN + International) IOA authentication",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./server": "./dist/server.js",
    "./codebuddy": "./dist/provider/codebuddy.js",
    "./codebuddy-intl": "./dist/provider/codebuddy-intl.js",
    "./workbuddy": "./dist/provider/workbuddy.js",
    "./workbuddy-intl": "./dist/provider/workbuddy-intl.js"
  },
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build"
